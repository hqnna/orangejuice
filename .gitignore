/target/
# The container dev shells build here: a tree per guest architecture, in the
# checkout because `oj` finds its modules by walking up from its own binary.
/target-arm64/
/target-amd64/
/result
/result-*
.build/

# An example built in place, which is what `oj docs/examples/010_hello.jai`
# leaves beside the source.
/docs/examples/*
!/docs/examples/*.jai
!/docs/examples/*.out
!/docs/examples/*.md
!/docs/examples/support/
