//
// Soa: struct of arrays, generated from a struct of scalars.
//
// `Soa(Particle, 1000)` gives a struct with one array per member — all the
// positions together, then all the velocities — rather than a thousand
// particles each holding a position beside a velocity. Code that touches one
// member across many items then reads contiguous memory instead of striding
// over the others, which is most of what makes it faster.
//
// The members are generated by `#insert` from the type table, so adding a
// field to the original struct adds an array here with nothing else to change.
//
// The reference's own Soa says it is an experiment in progress; this is the
// same idea with the same generation trick, kept to what is verifiable.
//

#import "Basic";

Soa :: struct (T: Type, N: s64)
#modify {
    info := cast(*Type_Info_Struct) T;
    // A non-struct has no members to spread, so reject the specialization
    // rather than generate something that will not compile.
    if !info || info.type != .STRUCT  return false;
    return true;
} {
    // What this was made from, so the accessors can name it without being
    // polymorphic themselves.
    Item  :: T;
    Count :: N;

    #insert -> string {
        builder: String_Builder;
        info := cast(*Type_Info_Struct) T;

        // A union or a `#place` puts two members at one offset. Generating an
        // array for each would double the storage and give two names for one
        // thing, so only members past the high-water mark are taken.
        highest := -1;
        for * member: info.members {
            if member.flags & .CONSTANT           continue;
            if member.offset_in_bytes < highest   continue;
            highest = member.offset_in_bytes + member.type.runtime_size;

            // `type_of(T.name)` rather than the type's spelling: the name is
            // not always something that can be written down here, and this
            // always is.
            print_to_builder(*builder, "    %: [N] type_of(T.%);\n", member.name, member.name);
        }
        return builder_to_string(*builder);
    }
}

// Accessors that gather an item back together, or scatter one into place,
// are not provided. They want a parameter naming this struct family — either
// `*Soa($T, $N)` or a `$S` a macro reads `S.Item` from — and orangejuice
// cannot yet reach an `#insert`-generated member through either
// (`docs/spec.md` §10.1). Direct access works and is how SOA is normally
// used anyway:
//
//     for i: 0..s.x.count-1  s.x[i] *= 2;
//     particle_x := s.x[3];
//
